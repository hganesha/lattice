{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/health", "destination": "https://REPLACE-WITH-YOUR-CONTEXT-API-HOST/health" },
    { "source": "/openapi.json", "destination": "https://REPLACE-WITH-YOUR-CONTEXT-API-HOST/openapi.json" },
    { "source": "/v1/:path*", "destination": "https://REPLACE-WITH-YOUR-CONTEXT-API-HOST/v1/:path*" }
  ]
}
