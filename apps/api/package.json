{
  "name": "@lattice/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "LATTICE_DEV_AUTH=true node --watch dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1101.0",
    "@lattice/compiler-core": "workspace:*",
    "@lattice/contracts": "workspace:*",
    "@lattice/importer-core": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@vercel/otel": "2.1.3",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "tedious": "^20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.4.0"
  },
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js"
  }
}
